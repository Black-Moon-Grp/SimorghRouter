# V2Ray Smart Router & Multi-User Manager Configuration
APP_NAME="V2Ray Smart Router"
HOST=0.0.0.0
PORT=8000

# Security - CHANGE THESE IN PRODUCTION (install.sh auto-generates a secure JWT_SECRET)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRE_HOURS=24
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123

# Public address of this VPS (domain or public IPv4) used for generating client links
PUBLIC_HOST=
# Inbound ports
VLESS_TCP_PORT=443
VLESS_WS_PORT=8443
VLESS_WS_PATH=/ws
TROJAN_PORT=2083

# Xray paths
XRAY_BIN=/usr/local/bin/xray
XRAY_ASSETS_DIR=/usr/local/share/xray
DATA_DIR=/var/lib/v2ray-router
XRAY_GRPC_ADDR=127.0.0.1:10085
OUTBOUND_BRIDGE_PORT=10808
OUTBOUND_PORT_A=10809
OUTBOUND_PORT_B=10810

# Speed test & scheduler defaults
DEFAULT_SPEEDTEST_INTERVAL_MIN=30
WATCHDOG_INTERVAL_SEC=60
STATS_POLL_INTERVAL_SEC=12
SPEEDTEST_WORKERS=10
SPEEDTEST_TIMEOUT_SEC=8
TEST_URL=https://www.gstatic.com/generate_204
SPEED_DL_URL=https://speed.cloudflare.com/__down?bytes=2000000

# GeoIP / Geosite default URLs
GEOIP_URL=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat
GEOSITE_URL=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat
